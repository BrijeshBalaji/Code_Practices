import java.util.*;
class adjacentswap{
    static void swapping(){
        Scanner sc =new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int[n];

        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        int k =sc.nextInt();
        int count=0;

        for(int i=0;i<2*k; i+=2){
            int temp=arr[i];
            arr[i]=arr[i+1];
            arr[i+1]=temp;
            count++;
        }
        for(int x:arr){
            System.out.print(x+ " ");
        }
    }
    public static void main(String args[]){
        swapping();
    }
}
